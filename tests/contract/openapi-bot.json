    "/api/members": {
      "get": {
        "description": "Persons from the roster with their account (role, state, last login link), the app role their Discord roles\ngive, and their Steam link's state.",
        "operationId": "list_members_api_members_get",
        "parameters": [
          {
            "description": "Username, display name or Discord id",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Username, display name or Discord id",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "member",
              "enum": [
                "member",
                "left",
                "all"
              ],
              "title": "State",
              "type": "string"
            }
          },
          {
            "description": "true: only persons with an account; false: without",
            "in": "query",
            "name": "account",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true: only persons with an account; false: without",
              "title": "Account"
            }
          },
          {
            "description": "Only members with a squad.xml rank role and no Steam link (the bot's link reminders)",
            "in": "query",
            "name": "unlinked",
            "required": false,
            "schema": {
              "default": false,
              "description": "Only members with a squad.xml rank role and no Steam link (the bot's link reminders)",
              "title": "Unlinked",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "maximum": 10000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Members Api Members Get",
                  "type": "object"
                }
