{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HeartbeatIn": {
        "properties": {
          "interval_s": {
            "description": "How often it reports (seconds)",
            "maximum": 3600.0,
            "minimum": 10.0,
            "title": "Interval S",
            "type": "integer"
          },
          "name": {
            "description": "The program, e.g. discord-bot",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "interval_s"
        ],
        "title": "HeartbeatIn",
        "type": "object"
      },
      "MemberPush": {
        "properties": {
          "display_name": {
            "default": "",
            "maxLength": 100,
            "title": "Display Name",
            "type": "string"
          },
          "in_guild": {
            "default": true,
            "description": "false: the member left the guild",
            "title": "In Guild",
            "type": "boolean"
          },
          "roles": {
            "description": "Discord role ids",
            "items": {
              "type": "string"
            },
            "maxItems": 500,
            "title": "Roles",
            "type": "array"
          },
          "username": {
            "description": "The Discord @username",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "MemberPush",
        "type": "object"
      },
      "NoticeDone": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "failed: why, e.g. dm_closed",
            "title": "Reason"
          },
          "state": {
            "enum": [
              "delivered",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "NoticeDone",
        "type": "object"
      },
      "RoleIn": {
        "properties": {
          "color": {
            "default": 0,
            "title": "Color",
            "type": "integer"
          },
          "id": {
            "pattern": "^\\d{1,25}$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "default": "",
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          },
          "position": {
            "default": 0,
            "title": "Position",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "RoleIn",
        "type": "object"
      },
      "RolesBody": {
        "properties": {
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleIn"
            },
            "maxItems": 1000,
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "title": "RolesBody",
        "type": "object"
      },
      "RosterBody": {
        "properties": {
          "members": {
            "items": {
              "$ref": "#/components/schemas/RosterMember"
            },
            "maxItems": 100000,
            "title": "Members",
            "type": "array"
          }
        },
        "required": [
          "members"
        ],
        "title": "RosterBody",
        "type": "object"
      },
      "RosterMember": {
        "properties": {
          "discord_id": {
            "pattern": "^\\d{1,25}$",
            "title": "Discord Id",
            "type": "string"
          },
          "display_name": {
            "default": "",
            "maxLength": 100,
            "title": "Display Name",
            "type": "string"
          },
          "roles": {
            "description": "Discord role ids",
            "items": {
              "type": "string"
            },
            "maxItems": 500,
            "title": "Roles",
            "type": "array"
          },
          "username": {
            "description": "The Discord @username",
            "maxLength": 100,
            "minLength": 1,
