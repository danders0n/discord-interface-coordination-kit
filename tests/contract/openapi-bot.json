            "type": "string"
          }
        },
        "required": [
          "username",
          "discord_id"
        ],
        "title": "RosterMember",
        "type": "object"
      },
      "SteamBody": {
        "properties": {
          "steam": {
            "description": "The 17-digit Steam64 ID or steamcommunity.com/profiles/<id>",
            "maxLength": 200,
            "minLength": 1,
            "title": "Steam",
            "type": "string"
          }
        },
        "required": [
          "steam"
        ],
        "title": "SteamBody",
        "type": "object"
      },
      "ValidationError": {
