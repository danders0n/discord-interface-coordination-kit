    "/api/events/stream": {
      "get": {
        "description": "Server-Sent Events: ``hello`` (``boot``, ``last_id``, ``replayed``, ``gap``), the events missed since the\nresume point, then live ones. Each message is ``{kind, seq, server, data}``. A ``server`` event's player data\n(Steam IDs, GUIDs, kick reasons) needs ``players.view``; ``job`` events need ``jobs.view``. Job progress\ncomes at most every 5 s per job and is not replayed; a comment every 15 s keeps the connection open.",
        "operationId": "stream_api_events_stream_get",
        "parameters": [
          {
            "description": "Comma separated: server, reservation, job, servers, member, notice (default: all)",
            "in": "query",
            "name": "kinds",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma separated: server, reservation, job, servers, member, notice (default: all)",
              "title": "Kinds"
            }
          },
          {
            "description": "Only this server's events (id or slug) and those about no single server",
            "in": "query",
            "name": "server",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this server's events (id or slug) and those about no single server",
              "title": "Server"
            }
          },
          {
            "description": "Resume after this event id ('<boot>:<seq>'); the Last-Event-ID header does the same",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resume after this event id ('<boot>:<seq>'); the Last-Event-ID header does the same",
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          },
          {
            "SessionCookie": []
          }
        ],
        "summary": "Stream",
        "tags": [
          "events"
        ]
      }
    },
