# =============================================================================
# Operations bot - configuration (copy to .env)
# =============================================================================
# The bot is the Discord front end of arma-server-supervisor: the operations, sign-ups, approval, attendance,
# Steam links and who may do what are the supervisor's (its app, Settings and the Discord roles table). Here are
# the bot's own settings: secrets, channels, the announcement role, the bot admins. Check a new file with
#   .venv\Scripts\python.exe -m app check-config
# and apply it with /reload (bot admins). The token, the guild, the data folder and the
# supervisor URL / token need a restart.
#
# - Channels and roles: an id or a name. Names are matched on the server at start-up and
#   on /reload, without regard to case; a missing or shared name is reported in the staff
#   log. Ids never break when something is renamed: Settings -> Advanced -> Developer
#   Mode, then right-click a channel or role -> Copy ID.
# - Lists: separated by ";" (BOT_PERMISSIONS__BOT_ADMIN=Admin;Zarzad) or JSON (["Admin", 222]).
# - An empty value means the default. Real environment variables override this file.

# --- Essentials ---------------------------------------------------------------

BOT_DISCORD_TOKEN=
BOT_GUILD_ID=

# Our group
BOT_GROUP__ACRONYM=IBC
BOT_GROUP__NAME=

# BOT_LANGUAGE=pl                         # language of public messages: pl | en
# BOT_TIMEZONE=Europe/Warsaw              # times are typed and shown in this zone (the supervisor's should match)
# BOT_DATA_DIR=data                       # database, backups, logs, the operations' files  [restart]

# --- Channels -------------------------------------------------------------------

BOT_CHANNELS__EVENTS_CATEGORY=            # every operation's channel, drafts too (members read, don't write: set once by hand)
BOT_CHANNELS__HEADER=                     # the calendar
BOT_CHANNELS__ANNOUNCEMENTS=
# BOT_CHANNELS__TOP=                      # kept at the top of the operations category, in this order, e.g. rules;announcements;header (the header goes first unless listed); the operations follow by date
BOT_CHANNELS__STAFF=                      # staff-only channel: the bot makes its threads in it
# BOT_CHANNELS__STAFF_LOG_THREAD=Staff log   # the bot's notes to staff
# BOT_CHANNELS__MODERATION_THREAD=Moderacja  # approval requests
# BOT_CHANNELS__ARCHIVE_PATTERN=Archiwum Q{quarter} {year}   # a quarter's archive category (made by the bot)
# BOT_CHANNELS__LINK_REMINDER=            # Steam link reminders for members with closed DMs

# --- Roles ----------------------------------------------------------------------

# BOT_ROLES__ANNOUNCEMENT=                # mentioned in announcements and when sign-up opens (with the climate's role)

# --- Permissions: permission -> roles ------------------------------------------
# Only the bot's own commands; everything else is the supervisor's role map.

BOT_PERMISSIONS__BOT_ADMIN=               # /reload, /privacy-erase, /links remind | reminders, every archived operation

# --- Operation channels -----------------------------------------------------------

# BOT_EVENTS__DISCUSSION=                 # name of each operation's discussion thread; default: Dyskusja / Discussion

# --- Times ------------------------------------------------------------------------

# BOT_TIMES__DEFAULT_DURATION_MINUTES=180 # pre-filled in the wizard
# BOT_TIMES__REMINDER_MINUTES=1440;60     # reminder pings, this long before the assembly
# BOT_TIMES__ARCHIVE_HOURS=48            # after the end of an operation, its channel moves to the archive this long later
# BOT_TIMES__CALENDAR_DAYS=14            # the header's calendar shows this many days
# BOT_TIMES__REPLY_SECONDS=60            # the bot's private replies without buttons disappear after this; 0: they stay

# --- arma-server-supervisor --------------------------------------------------------
# The bot's own account there needs the integration role (integration.act_as).

# BOT_SUPERVISOR__URL=http://localhost:8000     # [restart]
BOT_SUPERVISOR__TOKEN=                          # the bot account's personal API token  [restart]

# --- Steam link reminders ------------------------------------------------------------
# The links and squad.xml are the supervisor's (the app's Members page); the bot reminds members to link.

# BOT_LINKS__REMINDER_DAYS=14             # a member with a rank and no link is reminded this often (DM)
# BOT_LINKS__DMS_PER_HOUR=20              # reminder DMs per hour at most

# --- Long-term archive ------------------------------------------------------------
# Older quarters move into the database (transcripts, attachments) and their channels are deleted; /archive event
# reads them back. The host's own backups must include the attachments folder.

# BOT_ARCHIVE__KEEP_QUARTERS=4            # quarters kept as channels, the current one included
# BOT_ARCHIVE__ATTACHMENTS_DIR=           # default: <data dir>/archive

# --- Housekeeping -----------------------------------------------------------------

# BOT_BACKUP__KEEP=14                     # daily database backups kept (data/backups)
# BOT_LOGS__KEEP_DAYS=14                  # days of data/logs/bot.log kept
