# =============================================================================
# Event bot - configuration (copy to .env)
# =============================================================================
# Everything is here: secrets, channels, roles, permissions. Check a new file with
#   .venv\Scripts\python.exe -m app check-config
# and apply it with /reload (bot admins). The token, the guild, the data folder and the
# supervisor URL / token need a restart.
#
# - Channels and roles: an id or a name. Names are matched on the server at start-up and
#   on /reload, without regard to case; a missing or shared name is reported in the staff
#   log. Ids never break when something is renamed: Settings -> Advanced -> Developer
#   Mode, then right-click a channel or role -> Copy ID.
# - Lists: separated by ";" (BOT_ROLES__SIGNUP=Klanowicz;Kadet) or JSON (["Klanowicz", 222]).
# - An empty value means the default. Real environment variables override this file.

# --- Essentials ---------------------------------------------------------------

BOT_DISCORD_TOKEN=
BOT_GUILD_ID=

# Our group
BOT_GROUP__ACRONYM=IBC
BOT_GROUP__NAME=

# BOT_LANGUAGE=pl                         # language of public messages: pl | en
# BOT_TIMEZONE=Europe/Warsaw              # times are typed and shown in this zone
# BOT_DATA_DIR=data                       # database, backups, logs, images  [restart]

# --- Channels -------------------------------------------------------------------

BOT_CHANNELS__EVENTS_CATEGORY=            # every event's channel, drafts too (members read, don't write: set once by hand)
BOT_CHANNELS__HEADER=                     # the Create event button and the calendar
BOT_CHANNELS__ANNOUNCEMENTS=
# BOT_CHANNELS__TOP=                      # kept at the top of the events category, in this order, e.g. rules;announcements;header (the header goes first unless listed); the events follow by date
BOT_CHANNELS__STAFF=                      # staff-only channel: the bot makes its threads in it
# BOT_CHANNELS__STAFF_LOG_THREAD=Staff log   # the bot's notes to staff
# BOT_CHANNELS__MODERATION_THREAD=Moderacja  # approval requests
# BOT_CHANNELS__ARCHIVE_PATTERN=Archiwum Q{quarter} {year}   # a quarter's archive category (made by the bot)
# BOT_CHANNELS__LINK_REMINDER=            # Steam link reminders for members with closed DMs

# --- Roles ----------------------------------------------------------------------

BOT_ROLES__MEMBER=                        # member roles, e.g. Klanowicz: create events (internal / hosted ones need approval)
BOT_ROLES__MISSION_MAKER=                 # publishes without approval, builds server profiles
# BOT_ROLES__ANNOUNCEMENT=                # mentioned in announcements and when sign-up opens
BOT_ROLES__SIGNUP=                        # roles that may sign up, e.g. Klanowicz;Kadet
# BOT_ROLES__RANK=                        # membership ranks, shown in /profile (squad.xml ranks: the app)
# BOT_ROLES__REMARK=                      # specializations shown in /profile, e.g. Pilot;Medic

# --- Permissions: permission -> roles ------------------------------------------

BOT_PERMISSIONS__APPROVE_EVENTS=          # moderators
BOT_PERMISSIONS__MANAGE_ANY_EVENT=
# BOT_PERMISSIONS__SERVER_CONTROL=        # /server start | stop | restart
# BOT_PERMISSIONS__SERVER_MESSAGE=        # /server say
# BOT_PERMISSIONS__SERVER_OVERRIDE=       # "Start anyway?" during a reservation
# BOT_PERMISSIONS__MANAGE_LINKS=          # /links remind | reminders (the links themselves: the app)
BOT_PERMISSIONS__BOT_ADMIN=               # /reload, /attendance report, /privacy erase

# --- Events -------------------------------------------------------------------------

# BOT_EVENTS__CLIMATE_ROLES=              # interest roles members take, e.g. WW2;Cold War;Modern
# BOT_EVENTS__DISCUSSION=                 # name of each event's discussion thread; default: Dyskusja / Discussion
# The kinds' names as members see them (in every language); empty: the bot's own.
# BOT_EVENTS__KIND_NAMES__INTERNAL=       # default: Wewnętrzny / Internal
# BOT_EVENTS__KIND_NAMES__GUEST=          # another group hosts; default: Zewnętrzny organizator / Guest
# BOT_EVENTS__KIND_NAMES__HOSTED=         # ours, with invited groups; default: Zewnętrzni goście / Hosted
# BOT_EVENTS__KIND_NAMES__ZEUS=           # default: Zeus
# BOT_EVENTS__KIND_NAMES__TRAINING=       # default: Trening / Training

# --- Times ------------------------------------------------------------------------

# BOT_TIMES__OFFER_TIMEOUT_MINUTES=30     # a member offered a freed slot has this long to take it
# BOT_TIMES__OFFER_TO_ALL_MINUTES=60      # this close to the assembly, a freed slot goes to the whole reserve list
# BOT_TIMES__DEFAULT_DURATION_MINUTES=180 # pre-filled in the wizard
# BOT_TIMES__MAX_DAYS_AHEAD=120           # a date further ahead is refused as a likely typo
# BOT_TIMES__LEAD_MINUTES=45              # the reservation starts this long before the assembly
# BOT_TIMES__BUFFER_MINUTES=30            # ... and ends this long after start + duration
# BOT_TIMES__STALE_PING_HOURS=48          # still a draft this long before the assembly: the creator is pinged
# BOT_TIMES__STALE_CANCEL_HOURS=24        # still not published this long before: cancelled
# BOT_TIMES__REMINDER_MINUTES=1440;60     # reminder pings, this long before the assembly
# BOT_TIMES__ARCHIVE_HOURS=48            # after the attendance report, the channel moves to the archive
# BOT_TIMES__CALENDAR_DAYS=14            # the header's calendar shows this many days
# BOT_TIMES__REPLY_SECONDS=60            # the bot's private replies without buttons disappear after this; 0: they stay

# --- Attendance (from the supervisor's player stats) -------------------------------

# BOT_ATTENDANCE__MIN_MINUTES=30          # mission time that counts as attended
# BOT_ATTENDANCE__SETTLE_MINUTES=10       # after the end, wait this long for the stats (a new mission: it goes on)
# BOT_ATTENDANCE__FINISH_SHARE_PERCENT=60 # a finished mission ends the event only after start + this share of the duration
# BOT_ATTENDANCE__DEADLINE_HOURS=24       # retry reading the stats this long, then report them unavailable
# BOT_ATTENDANCE__GUEST_CONFIRM_DAYS=3    # a guest event's attendance still to confirm counts as attended after this
# BOT_ATTENDANCE__RATING_DAYS=3           # after the report, members rate the mission for this many days

# --- Creator DLC -> the role of members who own it ------------------------------
# A member signing up for an event whose preset needs a DLC they have no role for is warned
# (sign-up still works), and organisers see who lacks it.

# BOT_DLC_ROLES__GM=                      # Global Mobilization
# BOT_DLC_ROLES__VN=                      # S.O.G. Prairie Fire
# BOT_DLC_ROLES__CSLA=                    # CSLA Iron Curtain
# BOT_DLC_ROLES__WS=                      # Western Sahara
# BOT_DLC_ROLES__SPE=                     # Spearhead 1944
# BOT_DLC_ROLES__RF=                      # Reaction Forces
# BOT_DLC_ROLES__EF=                      # Expeditionary Forces

# --- arma-server-supervisor --------------------------------------------------------

# BOT_SUPERVISOR__URL=http://localhost:8000     # [restart]
BOT_SUPERVISOR__TOKEN=                          # the bot user's personal API token  [restart]
# BOT_SUPERVISOR__EVENT_SERVER=                 # slug of the default event server
# BOT_SUPERVISOR__BASE_PROFILE=                 # event profiles are cloned from it (name or id; not protected)
# BOT_SUPERVISOR__PROFILE_SWAP_MINUTES=5        # without reservation_profile: the event profile goes on this long before
# BOT_SUPERVISOR__PROFILE_KEEP_DAYS=14          # an event profile is deleted this long after the event

# --- Steam link reminders ------------------------------------------------------------
# The links and squad.xml are the supervisor's (the app's Members page); the bot reminds members to link.

# BOT_LINKS__REMINDER_DAYS=14             # a member with a rank and no link is reminded this often (DM)
# BOT_LINKS__DMS_PER_HOUR=20              # reminder DMs per hour at most

# --- Long-term archive ------------------------------------------------------------
# Older quarters move into the database (transcripts, attachments) and their channels are deleted; /archive event
# reads them back. The host's own backups must include the attachments folder.

# BOT_ARCHIVE__KEEP_QUARTERS=4            # quarters kept as channels, the current one included
# BOT_ARCHIVE__ATTACHMENTS_DIR=           # default: <data dir>/archive

# --- Housekeeping -----------------------------------------------------------------

# BOT_BACKUP__KEEP=14                     # daily database backups kept (data/backups)
# BOT_LOGS__KEEP_DAYS=14                  # days of data/logs/bot.log kept
