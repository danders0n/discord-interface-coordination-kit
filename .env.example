# =============================================================================
# Event bot - configuration (copy to .env)
# =============================================================================
# Everything is here: secrets, channels, roles, permissions. Check a new file with
#   .venv\Scripts\python.exe -m app check-config
# and apply it with /reload (bot admins). The token, the guild, the data folder and the
# supervisor URL / token need a restart.
#
# - Channels and roles: an id or a name. Names are matched on the server at start-up and
#   on /reload, without regard to case; a missing or shared name is reported in the staff
#   log. Ids never break when something is renamed: Settings -> Advanced -> Developer
#   Mode, then right-click a channel or role -> Copy ID.
# - Lists: separated by ";" (BOT_ROLES__SIGNUP=Klanowicz;Kadet) or JSON (["Klanowicz", 222]).
# - An empty value means the default. Real environment variables override this file.

# --- Essentials ---------------------------------------------------------------

BOT_DISCORD_TOKEN=
BOT_GUILD_ID=

# Our group
BOT_GROUP__ACRONYM=IBC
BOT_GROUP__NAME=

# BOT_LANGUAGE=pl                         # language of public messages: pl | en
# BOT_TIMEZONE=Europe/Warsaw              # times are typed and shown in this zone
# BOT_DATA_DIR=data                       # database, backups, logs, images  [restart]

# --- Channels -------------------------------------------------------------------

BOT_CHANNELS__DRAFTS_CATEGORY=            # hidden category: drafts and events waiting for approval
BOT_CHANNELS__EVENTS_CATEGORY=            # published events (members read, don't write: set once by hand)
BOT_CHANNELS__HEADER=                     # the Create event button and the calendar
BOT_CHANNELS__ANNOUNCEMENTS=
BOT_CHANNELS__STAFF=                      # staff-only channel: the bot makes its threads in it
# BOT_CHANNELS__STAFF_LOG_THREAD=Staff log   # the bot's notes to staff
# BOT_CHANNELS__MODERATION_THREAD=Moderacja  # approval requests
# BOT_CHANNELS__LINK_REMINDER=            # Steam link reminders for members with closed DMs

# --- Roles ----------------------------------------------------------------------

BOT_ROLES__MEMBER=                        # member roles, e.g. Klanowicz: create events (internal / hosted ones need approval)
BOT_ROLES__MISSION_MAKER=                 # publishes without approval, builds server profiles
# BOT_ROLES__ANNOUNCEMENT=                # mentioned in announcements and when sign-up opens
BOT_ROLES__SIGNUP=                        # roles that may sign up, e.g. Klanowicz;Kadet

# --- Permissions: permission -> roles ------------------------------------------

BOT_PERMISSIONS__APPROVE_EVENTS=          # moderators
BOT_PERMISSIONS__MANAGE_ANY_EVENT=
# BOT_PERMISSIONS__SERVER_CONTROL=        # /server start | stop | restart
# BOT_PERMISSIONS__SERVER_MESSAGE=        # /server say
# BOT_PERMISSIONS__SERVER_OVERRIDE=       # "Start anyway?" during a reservation
# BOT_PERMISSIONS__MANAGE_LINKS=          # anyone's Steam link and nick
BOT_PERMISSIONS__BOT_ADMIN=               # /reload, /attendance report, /privacy erase

# --- Times ------------------------------------------------------------------------

# BOT_TIMES__OFFER_TIMEOUT_MINUTES=30     # a member offered a freed slot has this long to take it
# BOT_TIMES__OFFER_TO_ALL_MINUTES=60      # this close to the assembly, a freed slot goes to the whole reserve list

# --- Creator DLC -> the role of members who own it ------------------------------
# A member signing up for an event whose preset needs a DLC they have no role for is warned
# (sign-up still works), and organisers see who lacks it.

# BOT_DLC_ROLES__GM=                      # Global Mobilization
# BOT_DLC_ROLES__VN=                      # S.O.G. Prairie Fire
# BOT_DLC_ROLES__CSLA=                    # CSLA Iron Curtain
# BOT_DLC_ROLES__WS=                      # Western Sahara
# BOT_DLC_ROLES__SPE=                     # Spearhead 1944
# BOT_DLC_ROLES__RF=                      # Reaction Forces
# BOT_DLC_ROLES__EF=                      # Expeditionary Forces

# --- arma-server-supervisor --------------------------------------------------------

# BOT_SUPERVISOR__URL=http://localhost:8000     # [restart]
BOT_SUPERVISOR__TOKEN=                          # the bot user's personal API token  [restart]
# BOT_SUPERVISOR__EVENT_SERVER=                 # slug of the default event server

# --- Housekeeping -----------------------------------------------------------------

# BOT_BACKUP__KEEP=14                     # daily database backups kept (data/backups)
# BOT_LOGS__KEEP_DAYS=14                  # days of data/logs/bot.log kept
